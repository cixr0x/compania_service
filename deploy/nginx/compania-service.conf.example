# HTTP bootstrap template. Production HTTPS is managed by Certbot; do not
# overwrite the active production site during a routine application deploy.
server {
    listen 80;
    server_name compania.bobbycrimson.com;

    root /home/robertorojas87/compania_service/frontend/dist;
    index index.html;

    client_max_body_size 25m;

    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
